f(!g)return ['Ready','to play'];
+      const phase=String(g.phase||'');
+      if(['bidding','deal','dealing'].includes(phase))return ['Bidding','in progress'];
+      const bid=Number(g.bid)||0, bidder=Number(g.bidder);
+      if(bid<=0||!Number.isInteger(bidder)||bidder<0)return ['Next','hand'];
+      if(phase==='score'||phase==='finished'||phase==='gameover')return ['Hand','complete'];
+      const team=bidder%2,mine=(typeof myIndex==='number'&&myIndex>=0?myIndex:0)%2;
+      const pointsFor=(side)=>Array.isArray(g.tricksTaken?.[side])&&typeof cardPoints==='function'
+        ?g.tricksTaken[side].reduce((s,c)=>s+(Number(cardPoints(c))||0),0)
+        :Number(g.handPoints?.[side]);
+      const teamPts=pointsFor(team);
+      if(mine===team){
+        if(!Number.isFinite(teamPts))return ['Bid '+bid,'in progress'];
+        const needed=Math.max(0,Math.ceil(bid-teamPts));
+        return needed?['Need '+needed,'to make bid']:['Bid made',''];
+      }
+      // To mathematically SET the bidding team we must capture enough counters
+      // that their maximum possible score falls short of their bid.
+      // The deck counter total varies with Red Two / Red One / ones toggles.
+      const ownPts=pointsFor(mine);
+      const total=typeof totalCountersInDeck==='function'?totalCountersInDeck():NaN;
+      if(!Number.isFinite(ownPts)||!Number.isFinite(total))return ['Set them','Bid '+bid];
+      const toSet=Math.max(0,Math.floor(total-bid-ownPts)+1);
+      return toSet?['Need '+toSet,'to set them']:['Opponents','set'];
+    }catch(e){return ['Hand','in progress']}
+  };
+  const refresh=()=>{
+    const a=scoreA?.textContent.trim()||'0', b=scoreB?.textContent.trim()||'0';
+    if(scoreOutA.textContent!==a)scoreOutA.textContent=a;
+    if(scoreOutB.textContent!==b)scoreOutB.textContent=b;
+    const now=new Date();const display=now.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit',hour12:true});
+    if(clock.textContent!==display){clock.textContent=display;clock.dateTime=now.toISOString()}
+    const lines=status(), key=lines.join('|');
+    if(goal.dataset.key!==key){goal.dataset.key=key;goal.replaceChildren(...lines.filter(Boolean).map(x=>{const s=document.createElement('span');s.textContent=x;return s}))}
+  };
+  function restoreOriginalControls(){
+    if(speed.parentElement!==speedHome) speedHome?.appendChild(speed);
+    if(last.parentElement!==lastHome) lastHome?.appendChild(last);
+    if(bar.parentElement!==barHome) barHome?.appendChild(bar);
+    if(menu && menu.innerHTML!==originalMenu) menu.innerHTML=originalMenu;
+    if(back && back.innerHTML!==originalBack) back.innerHTML=originalBack;
+    fs.hidden=true;
+  }
+  function moveSpeed(host){
+    if(speed.parentNode!==host)host.appendChild(speed);
+    if(last.parentNode!==host)host.appendChild(last);
+  }
+  function layout(){
+    const active=document.body.classList.contains('in-game')&&matchMedia('(orientation:portrait)').matches && !gid('game')?.classList.contains('hidden');
+    ui.hidden=!active;
+    if(!active){clockConsole.hidden=true;topStage.style.display='none';bottomStage.style.display='none';bar.classList.remove('house-utility-group');restoreOriginalControls();return}
+    fs.hidden=false;
+    if(menu && menu.textContent) menu.textContent='';
+    if(back && back.textContent) back.textContent='';
+    bar.classList.add('house-utility-group');
+    if(bar.parentNode!==document.body)document.body.appendChild(bar);
+    const {x,y,w,h}=viewport(), full=installed();
+    const ico=Math.max(27,Math.min(34,Math.floor(w*.075))), gap=Math.max(3,Math.floor(w*.012));
+    const iw=ico*3+gap*2, stepH=Math.max(25,Math.floor(w*.079)),paceW=Math.max(136,Math.min(176,w*.44));
+    const headerW=Math.round(full?w-iw-20:w-paceW-20);
+    const xScore=Math.round(x+7),yScore=Math.round(y+4);
+    plaque.style.left=xScore+'px';plaque.style.top=yScore+'px';
+    plaque.style.width=headerW+'px';plaque.style.height=Math.round(headerW*87/600)+'px';
+    set(bar,'--house-tool-size',ico+'px');set(bar,'--house-tool-gap',gap+'px');
+    set(bar,'left',Math.round(full?x+w-iw-8:x+w-iw-8)+'px');set(bar,'right','auto');
+    set(bar,'top',Math.round(full?y+4:y+5+headerW*87/600+5)+'px');set(bar,'bottom','auto');
+    set(ui,'height',Math.round((full?50:92))+'px');
+    const hr=document.querySelector('.game-room > .hand-area')?.getBoundingClientRect();
+    const free=hr ? y+h-hr.bottom : 0;
+    const panelW=Math.floor(w-2),panelH=Math.round(panelW*192/941);
+    const allowPanel=Boolean(full&&hr&&free>=panelH+5&&w>=320);
+    clockConsole.hidden=!allowPanel;
+    if(allowPanel){
+      const top=Math.max(hr.bottom+3,y+h-panelH-2);
+      set(clockConsole,'left',Math.round(x+(w-panelW)/2)+'px');set(clockConsole,'top',Math.round(top)+'px');
+      set(clockConsole,'width',panelW+'px');set(clockConsole,'height',panelH+'px');
+      // The 3 balanced photographic recesses are fixed in the physical asset.
+      bottomStage.style.display='flex';topStage.style.display='none';
+      bottomStage.style.position='absolute';bottomStage.style.left='28.3%';bottomStage.style.width='42.7%';
+      bottomStage.style.top='27%';bottomStage.style.height='43%';
+      moveSpeed(bottomStage);
+    }else{
+      clockConsole.hidden=true;bottomStage.style.display='none';topStage.style.display='flex';
+      set(topStage,'left',Math.round(x+w-paceW-7)+'px');set(topStage,'top',Math.round(y+4)+'px');
+      set(topStage,'width',Math.round(paceW)+'px');set(topStage,'height',Math.round(stepH)+'px');
+      moveSpeed(topStage);
+    }
+    fs.title=full?'Exit full screen':'Full screen';fs.setAttribute('aria-label',fs.title);
+    document.body.dataset.housePremiumLayout=allowPanel?'installed-console':'browser-top';
+    refresh();
+  }
+  let queued=false;
+  const schedule=()=>{if(queued)return;queued=true;requestAnimationFrame(()=>{queued=false;layout()})};
+  for(const n of ['resize','orientationchange','pageshow','fullscreenchange','webkitfullscreenchange'])addEventListener(n,schedule);
+  vv?.addEventListener('resize',schedule);vv?.addEventListener('scroll',schedule);
+  const scoreObserver=new MutationObserver(()=>{refresh()});
+  for(const e of [scoreA,scoreB])if(e)scoreObserver.observe(e,{characterData:true,childList:true,subtree:true});
+  new MutationObserver(schedule).observe(document.body,{attributes:true,attributeFilter:['class']});
+  if(typeof ResizeObserver==='function'){
+    const hr=document.querySelector('.game-room > .hand-area');if(hr)new ResizeObserver(schedule).observe(hr);
+  }
+  // Native gameplay calls positionRailControls035() on phase/turn updates.
+  // It explicitly supports this hook.  Prevent the old scene-rail coordinator
+  // from moving the owner-approved asset utility buttons onto the table.
+  const previousRailCoordinator=window.HORRailControlsReview;
+  window.HORRailControlsReview={
+    position(controls){
+      if(controls===bar && document.body.classList.contains('in-game') &&
+         matchMedia('(orientation:portrait)').matches &&
+         !gid('game')?.classList.contains('hidden')){
+        // Native positionRailControls035 runs during card animations.  It only
+        // needs to defer to the already-positioned asset controls here.
+        // Re-scheduling layout from this callback caused reentrant redraw work.
+        return true;
+      }
+      return previousRailCoordinator?.position?.(controls)===true;
+    }
+  };
+  setInterval(()=>{if(document.body.classList.contains('in-game'))refresh()},750);
+  if(document.readyState==='loading')addEventListener('DOMContentLoaded',schedule,{once:true});
+  schedule();
+  window.HORPremiumUI1020={refresh,layout};
+})();
