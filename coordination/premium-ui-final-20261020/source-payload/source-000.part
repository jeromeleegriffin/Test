diff --git a/.github/workflows/premium-ui-browser-qa.yml b/.github/workflows/premium-ui-browser-qa.yml
new file mode 100644
index 0000000..8d0497a
--- /dev/null
+++ b/.github/workflows/premium-ui-browser-qa.yml
@@ -0,0 +1,27 @@
+name: Premium UI isolated browser QA
+on:
+  push:
+    branches: [work/premium-ui-final-integration-20261020]
+    paths:
+      - 'coordination/premium-ui-final-20261020/qa_integrated.py'
+      - '.github/workflows/premium-ui-browser-qa.yml'
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  browser:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - run: pip install playwright==1.56.0
+      - run: playwright install --with-deps chromium
+      - run: python coordination/premium-ui-final-20261020/qa_integrated.py
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: premium-ui-real-hand-screenshots
+          path: coordination/premium-ui-final-20261020/browser-results/
